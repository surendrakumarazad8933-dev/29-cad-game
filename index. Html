<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>29 Card Game - Offline</title>
    <style>
        body {
            margin: 0;
            background: #0f380f;
            color: white;
            font-family: Arial, sans-serif;
            text-align: center;
            overflow-x: hidden;
        }
        h2 { margin: 10px 0; font-size: 20px; color: #f1c40f; }
        #info-panel {
            background: rgba(0,0,0,0.3);
            padding: 8px;
            font-size: 14px;
            margin-bottom: 10px;
        }
        #table {
            position: relative;
            width: 90vw;
            height: 250px;
            margin: 10px auto;
            border: 2px dashed #27ae60;
            border-radius: 12px;
            background: #145a32;
        }
        .played-card {
            position: absolute;
            width: 55px;
            height: 80px;
            background: white;
            color: black;
            border-radius: 6px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            font-size: 16px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.3);
        }
        #card-top { top: 10px; left: calc(50% - 27px); }
        #card-bottom { bottom: 10px; left: calc(50% - 27px); }
        #card-left { top: 85px; left: 15px; }
        #card-right { top: 85px; right: 15px; }

        #hand-container {
            width: 95vw;
            margin: 10px auto;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 6px;
            min-height: 100px;
        }
        .card {
            width: 55px;
            height: 80px;
            background: #fff;
            color: #333;
            border-radius: 6px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            font-size: 15px;
            cursor: pointer;
            box-shadow: 0 3px 6px rgba(0,0,0,0.4);
            transition: transform 0.2s;
        }
        .card:active { transform: scale(0.95); }
        .red { color: #e74c3c; }
        .black { color: #2c3e50; }
        #status {
            margin: 10px;
            font-size: 14px;
            font-weight: bold;
            color: #ffeaa7;
        }
        button {
            padding: 8px 16px;
            background: #e67e22;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 14px;
            cursor: pointer;
            margin-top: 5px;
        }
    </style>
</head>
<body>

    <h2>29 कार्ड गेम (Offline)</h2>
    <div id="info-panel">
        आपके पॉइंट्स: <span id="my-score">0</span> | AI स्कोर: <span id="ai-score">0</span>
    </div>

    <div id="status">गेम शुरू हो रहा है...</div>

    <div id="table">
        <div id="card-top" class="played-card" style="display:none;"></div>
        <div id="card-left" class="played-card" style="display:none;"></div>
        <div id="card-right" class="played-card" style="display:none;"></div>
        <div id="card-bottom" class="played-card" style="display:none;"></div>
    </div>

    <h3>आपके कार्ड्स (हाथ में):</h3>
    <div id="hand-container"></div>

    <button id="next-btn" style="display:none;" onclick="nextTurn()">अगला टर्न</button>

    <script>
        const suits = ['♠', '♣', '♥', '♦'];
        const values = ['7', '8', '9', '10', 'J', 'Q', 'K', 'A'];
        
        // 29 गेम के कार्ड पॉइंट सिस्टम (J=3, 9=2, A=1, 10=1, बाकी 0)
        function getCardPoints(val) {
            if (val === 'J') return 3;
            if (val === '9') return 2;
            if (val === 'A' || val === '10') return 1;
            return 0;
        }

        let deck = [];
        let myHand = [];
        let ai1Hand = [];
        let ai2Hand = [];
        let ai3Hand = [];
        let myScore = 0;
        let aiScore = 0;

        function createDeck() {
            deck = [];
            for (let s of suits) {
                for (let v of values) {
                    deck.push({ suit: s, value: v, points: getCardPoints(v) });
                }
            }
            // शफल करें
            deck.sort(() => Math.random() - 0.5);
        }

        function startGame() {
            createDeck();
            myHand = deck.slice(0, 8);
            ai1Hand = deck.slice(8, 16);
            ai2Hand = deck.slice(16, 24);
            ai3Hand = deck.slice(24, 32);

            myScore = 0;
            aiScore = 0;
            document.getElementById('my-score').textContent = myScore;
            document.getElementById('ai-score').textContent = aiScore;
            document.getElementById('next-btn').style.display = 'none';

            renderHand();
            document.getElementById('status').textContent = "आपकी बारी है। कोई एक कार्ड चुनें!";
        }

        function renderHand() {
            const container = document.getElementById('hand-container');
            container.innerHTML = '';
            myHand.forEach((card, index) => {
                const cardDiv = document.createElement('div');
                cardDiv.className = `card ${card.suit === '♥' || card.suit === '♦' ? 'red' : 'black'}`;
                cardDiv.innerHTML = `<span>${card.value}</span><span>${card.suit}</span>`;
                cardDiv.onclick = () => playCard(index);
                container.appendChild(cardDiv);
            });
        }

        function playCard(index) {
            let card = myHand.splice(index, 1)[0];
            renderHand();

            // यूजर का कार्ड टेबल पर दिखाएं
            showPlayedCard('card-bottom', card);
            document.getElementById('status').textContent = "AI खिलाड़ी खेल रहे हैं...";

            // AI बोट्स के कार्ड खेलें (सिमुलेशन)
            setTimeout(() => {
                let ai1Card = ai1Hand.pop();
                showPlayedCard('card-left', ai1Card);
            }, 500);

            setTimeout(() => {
                let ai2Card = ai2Hand.pop();
                showPlayedCard('card-top', ai2Card);
            }, 1000);

            setTimeout(() => {
                let ai3Card = ai3Hand.pop();
                showPlayedCard('card-right', ai3Card);
                
                // स्कोर कैलकुलेशन (सरलीकृत)
                let roundPoints = card.points + 2; // कुछ रैंडम AI पॉइंट्स जोड़कर
                myScore += roundPoints;
                document.getElementById('my-score').textContent = myScore;

                document.getElementById('status').textContent = "यह टर्न पूरा हुआ! 'अगला टर्न' दबाएं।";
                
                if (myHand.length > 0) {
                    document.getElementById('next-btn').style.display = 'inline-block';
                } else {
                    document.getElementById('status').textContent = "गेम समाप्त! कुल स्कोर: " + myScore;
                }
            }, 1500);
        }

        function showPlayedCard(elementId, card) {
            const el = document.getElementById(elementId);
            el.className = `played-card ${card.suit === '♥' || card.suit === '♦' ? 'red' : 'black'}`;
            el.innerHTML = `<span>${card.value}</span><span>${card.suit}</span>`;
            el.style.display = 'flex';
        }

        function nextTurn() {
            document.getElementById('card-top').style.display = 'none';
            document.getElementById('card-left').style.display = 'none';
            document.getElementById('card-right').style.display = 'none';
            document.getElementById('card-bottom').style.display = 'none';
            document.getElementById('next-btn').style.display = 'none';
            document.getElementById('status').textContent = "अगला टर्न शुरू! अपना कार्ड चुनें।";
        }

        // गेम पहली बार लोड होने पर शुरू करें
        startGame();
    </script>
</body>
</html>
